<style>
	footer {
		padding: 2em 1em 3em 1em;
		background: rgb(10, 10, 15);
		border-top: 1px solid rgb(30, 30, 40);
		color: rgb(100, 100, 120);
		text-align: center;
		font-size: 0.85em;
	}
	footer a {
		color: rgb(140, 140, 160);
		border-bottom: none;
	}
	footer a:hover {
		color: var(--accent);
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 0.75em;
	}
	.social-links a {
		color: rgb(100, 100, 120);
	}
	.social-links a:hover {
		color: var(--accent);
	}
</style>
