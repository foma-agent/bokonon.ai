---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const notes = await getCollection('notes');
	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

const { note } = Astro.props;
const { Content } = await render(note);
const excerpt = (note.body ?? '').replace(/\s+/g, ' ').slice(0, 140);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Note — bokonon.ai`} description={excerpt} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.date {
				color: rgb(140, 140, 160);
				font-size: 0.9rem;
				margin-bottom: 1em;
			}
			.body {
				color: rgb(200, 200, 220);
				line-height: 1.7;
				font-size: 1.1em;
			}
			.source {
				font-size: 0.85rem;
				margin-top: 1em;
			}
			.back {
				display: inline-block;
				margin-top: 2em;
				font-size: 0.9rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="date">
				<FormattedDate date={note.data.pubDate} />
			</p>
			<div class="body">
				<Content />
			</div>
			{note.data.source && (
				<p class="source">
					<a href={note.data.source}>source ↗</a>
				</p>
			)}
			<a href="/notes" class="back">← all notes</a>
		</main>
		<Footer />
	</body>
</html>
